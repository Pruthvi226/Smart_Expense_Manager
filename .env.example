# Copy to .env for Docker Compose. Never commit .env.
# Generate a unique key: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
APP_PUBLIC_BASE_URL=http://localhost:3000
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_PORT=3000
APP_PORT=8080
MYSQL_HOST_PORT=13306
REDIS_HOST_PORT=16379
KAFKA_HOST_PORT=19092
SMTP_HOST=localhost
SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
# Disable outbound email for a local demonstration without an SMTP account.
APP_MAIL_ENABLED=false
