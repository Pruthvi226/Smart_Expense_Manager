# Smart Expense Manager V2 Environment Configuration Template

# Server & Network Configuration
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/

# Database Configuration (MySQL 8)
DATABASE_URL=jdbc:mysql://localhost:3306/smart_expense_manager?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true
DATABASE_USERNAME=root
DATABASE_PASSWORD=rootpassword

# Redis Caching Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Apache Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# JWT Security
JWT_SECRET=SmartExpenseManagerProductionJwtSecretKeyChangeMeToAnUltraSecureSecret1234567890
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Email SMTP Notification Configuration
EMAIL_USERNAME=noreply@smartexpense.com
EMAIL_PASSWORD=smtp_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# AI Features Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
